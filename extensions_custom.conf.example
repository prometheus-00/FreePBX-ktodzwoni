; ============================================================
; KTO DZWONI? - FreePBX / Asterisk
; ============================================================
;
; Wklej odpowiednie sekcje do:
; /etc/asterisk/extensions_custom.conf
;
; Następnie:
; asterisk -rx "dialplan reload"
;
; Uwaga:
; punkt włączenia live-call jest realizowany przez:
; /etc/asterisk/extensions_override_freepbx.conf
;
; ============================================================

[live-call]
exten => s,1,NoOp(=== LIVE CALL IDENTIFICATION ===)
 same => n,AGI(/var/www/html/telefon/live-call.php)
 same => n,Set(CHANNEL(hangup_handler_push)=live-call-hangup,s,1(${UNIQUEID}))
 same => n,Return()

[live-call-hangup]
exten => s,1,NoOp(=== LIVE CALL HANGUP ===)
 same => n,AGI(/var/www/html/telefon/live-call-hangup.php,${ARG1})
 same => n,Return()
